{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "xinchejian",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Wrangler creates the D1 database and R2 bucket on the first deploy.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "xinchejian",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "xinchejian-media",
		},
	],
	"routes": [
		{ "pattern": "xinchejian.com", "custom_domain": true },
		// Bound only so it can 301 to the apex; see src/host-redirect.ts.
		{ "pattern": "www.xinchejian.com", "custom_domain": true },
	],
	// Keep the workers.dev address to tell DNS problems from app problems.
	"workers_dev": true,
	// Public origin used by EmDash for passkeys, OAuth, CSRF, and setup. Only
	// loopback hosts can run setup without it, so production needs it set.
	"vars": {
		"EMDASH_SITE_URL": "https://xinchejian.com",
	},
	// Cloudflare Email Sending, for magic-link sign-in and account recovery.
	// The sender domain (xinchejian.com) has to be onboarded under Compute >
	// Email Service first; that adds Cloudflare's MX/SPF/DKIM on cf-bounce and a
	// DMARC record at _dmarc, and leaves the apex MX (Google Workspace) alone.
	"send_email": [{ "name": "EMAIL" }],
	// Image uploads compute a blurhash + dominant colour; the default CPU budget
	// is too small for large photos and returns 503. Paid plans allow up to 30s.
	"limits": { "cpu_ms": 30000 },
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
	// Staging, on beta.xinchejian.com. Its own Worker, D1 database and R2 bucket,
	// so a preview build and its first-request migrations cannot touch production
	// content. Named environments inherit no bindings: everything the beta Worker
	// needs is repeated here. Select it with CLOUDFLARE_ENV=beta at build and
	// deploy time, not --env; see README.
	"env": {
		"beta": {
			"name": "xinchejian-beta",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "xinchejian-beta",
				},
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "xinchejian-media-beta",
				},
			],
			"routes": [{ "pattern": "beta.xinchejian.com", "custom_domain": true }],
			// beta is its own origin now, so it is the site URL here. Production
			// stopped accepting it once this environment took over the hostname.
			"vars": {
				"EMDASH_SITE_URL": "https://beta.xinchejian.com",
			},
			"send_email": [{ "name": "EMAIL" }],
			"limits": { "cpu_ms": 30000 },
			"triggers": {
				"crons": ["* * * * *"],
			},
		},
	},
}
