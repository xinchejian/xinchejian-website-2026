---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { LOCALES, getLocale, pagePath } from "../utils/i18n";
import { assertContent } from "../utils/content";

const locale = getLocale(Astro);

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

/** A page carrying a title but no body is an import artifact, not a page. */
const hasContent = (entry: { data?: { content?: readonly unknown[] } } | null | undefined): boolean =>
	(entry?.data?.content?.length ?? 0) > 0;

const pageResult = await getEmDashEntry("pages", slug, { locale });
assertContent(pageResult);
const { entry: page, cacheHint } = pageResult;

if (!page) {
	for (const other of LOCALES.filter((l) => l !== locale)) {
		const otherResult = await getEmDashEntry("pages", slug, { locale: other });
		assertContent(otherResult);
		if (otherResult.entry) return Astro.redirect(pagePath(other, slug), 302);
	}
	return Astro.rewrite("/404");
}

// A page can exist in one locale with nothing in it — the WordPress import
// produced contact-us that way in Chinese. Send the reader to a locale that
// has something to read rather than serving an empty shell. 302 rather than
// 301 because the translation may be written later, and this should stop
// redirecting once it is.
if (!hasContent(page)) {
	for (const other of LOCALES.filter((l) => l !== locale)) {
		const otherResult = await getEmDashEntry("pages", slug, { locale: other });
		assertContent(otherResult);
		if (hasContent(otherResult.entry)) return Astro.redirect(pagePath(other, slug), 302);
	}
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class="page-article">
		<header class="page-header">
			<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
		</header>

		<div class="page-content" {...page.edit.content}>
			<PortableText value={page.data.content} />
		</div>
	</article>
</Base>

<style>
	.page-article {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-8);
	}

	.page-title {
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
	}

	.page-content :global(p) {
		margin-bottom: 1.5em;
	}

	.page-content :global(h2) {
		font-size: var(--font-size-2xl);
		margin-top: 2em;
		margin-bottom: 0.75em;
	}

	.page-content :global(h3) {
		font-size: var(--font-size-xl);
		margin-top: 1.75em;
		margin-bottom: 0.5em;
	}

	.page-content :global(blockquote) {
		margin: 1.5em 0;
		padding-left: var(--spacing-6);
		border-left: 3px solid var(--color-border);
		color: var(--color-muted);
	}

	.page-content :global(pre) {
		margin: 1.5em 0;
		padding: var(--spacing-4);
		background: var(--color-surface);
		border-radius: var(--radius);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
	}

	.page-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface);
		padding: 0.15em 0.3em;
		border-radius: var(--radius);
	}

	.page-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.page-content :global(ul),
	.page-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: var(--spacing-5);
	}

	.page-content :global(li) {
		margin-bottom: 0.5em;
	}
</style>
